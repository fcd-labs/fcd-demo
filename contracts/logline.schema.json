{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fcd-labs/fcd-demo/contracts/logline.schema.json",
  "title": "Logline",
  "description": "One log line of fcd-demo: a CDEvent (CD Foundation, spec 0.4) with FCD fields in customData. Version 0.1.0.",
  "type": "object",
  "required": ["context", "subject", "customData"],
  "properties": {
    "context": {
      "type": "object",
      "required": ["version", "id", "source", "type", "timestamp"],
      "properties": {
        "version": { "type": "string", "description": "CDEvents spec version, e.g. 0.4.1" },
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "source": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Who sends: fcd-demo-pipeline/<version> or <sub-product>/<version>" },
        "type": {
          "type": "string",
          "enum": [
            "dev.cdevents.pipelinerun.started.0.2.0",
            "dev.cdevents.pipelinerun.finished.0.2.0",
            "dev.cdevents.taskrun.started.0.2.0",
            "dev.cdevents.taskrun.finished.0.2.0",
            "dev.cdevents.testsuiterun.finished.0.2.0",
            "dev.cdevents.service.deployed.0.2.0",
            "dev.cdevents.artifact.published.0.2.0",
            "dev.cdeventsx.fcd-qualitygate.evaluated.0.1.0",
            "dev.cdeventsx.fcd-keyresult.measured.0.1.0"
          ]
        },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the activity began or the event happened (UTC)" }
      }
    },
    "subject": {
      "type": "object",
      "required": ["id", "content"],
      "properties": {
        "id": { "type": "string", "maxLength": 200 },
        "source": { "type": "string", "maxLength": 200, "description": "Repository" },
        "content": { "type": "object", "description": "Per type, see logline.md" }
      }
    },
    "customData": {
      "type": "object",
      "required": ["durationSeconds", "trigger", "product", "subProduct", "showcase", "experiment", "environment"],
      "properties": {
        "durationSeconds": { "type": "number", "minimum": 0 },
        "run": { "type": "string", "maxLength": 200, "description": "Pipeline run id (empty for a key-result measurement)" },
        "commit": {
          "type": "object",
          "properties": { "sha": { "type": "string" }, "time": { "type": "string", "format": "date-time" } }
        },
        "trigger": {
          "type": "object",
          "required": ["kind", "name"],
          "properties": {
            "kind": { "type": "string", "enum": ["human", "ai-agent", "automated-update", "guest"] },
            "name": { "type": "string", "maxLength": 200 }
          }
        },
        "product": { "type": "string", "maxLength": 100 },
        "subProduct": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "maxLength": 100 },
            "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
            "containers": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "showcase": { "type": "string", "enum": ["demo", "classic", "ideal"] },
        "experiment": { "type": "string", "maxLength": 50, "description": "e.g. mvp0; every experiment starts with an empty log" },
        "environment": { "type": "string", "enum": ["werkplek", "lokaal"], "description": "werkplek: before a push; lokaal: the deployed environment" },
        "releaseType": { "type": "string", "enum": ["planned", "emergency"] }
      }
    }
  }
}
