#!/usr/bin/env bash
# Starting point of the showcase Demo. The logic is in the sub-product Pipeline (fcd-demo-pipeline).
#   ./fcd check   what is missing before anything goes wrong
#   ./fcd up      start the Pipeline agent; it builds and deploys ShowKitchen and the Dashboard from main
#   ./fcd down    stop everything
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
pipeline="$(dirname "$here")/fcd-demo-pipeline/fcd"
if [ ! -x "$pipeline" ]; then
  echo "✗ fcd-demo-pipeline ontbreekt. Clone de repositories naast elkaar:" >&2
  echo "  git clone https://github.com/fcd-labs/fcd-demo-pipeline.git \"$(dirname "$here")/fcd-demo-pipeline\"" >&2
  exit 1
fi
exec "$pipeline" "$@"
